###############################################################################
# STAGE 18 — ITERATIVE OVERLAP PEAK MERGING
###############################################################################

stage_18() {
    log "STAGE 18: Iterative overlap peak merging"

    require_cmd Rscript
    require_file "${BLACKLIST}"
    require_file "${ITERATIVE_SCRIPT}"

    local META="${MACS_DIR}/metadata_atac.txt"

    shopt -s nullglob
    local summits=("${MACS_DIR}"/*.macs3_summits.bed)
    (( ${#summits[@]} > 0 )) || die "No MACS3 summit files found for Stage 18"

    printf "Sample\tGroup\n" > "${META}"

    for f in "${summits[@]}"; do
        local filename sample group

        filename=$(basename "${f}")
        sample="${filename%_summits.bed}"

        case "${sample}" in
            *DMSO*)
                group="DMSO"
                ;;
            *THZ531-2H*)
                group="THZ2h"
                ;;
            *THZ531-4H*)
                group="THZ4h"
                ;;
            *THZ531-6H*)
                group="THZ6h"
                ;;
            *)
                die "Cannot assign experimental group for ${sample}"
                ;;
        esac

        printf "%s\t%s\n" "${sample}" "${group}" >> "${META}"
    done

    log "Metadata written to ${META}"

    if have column; then
        column -t -s $'\t' "${META}"
    else
        cat "${META}"
    fi

    Rscript "${ITERATIVE_SCRIPT}" \
        --metadata "${META}" \
        --macs2dir "${MACS_DIR}/" \
        --outdir "${ITERATIVE_OUTDIR}" \
        --suffix "_summits.bed" \
        --blacklist "${BLACKLIST}" \
        --genome hg38 \
        --spm 5 \
        --rule "(n+1)/2" \
        --extend 250

    log "STAGE 18 complete"
}

