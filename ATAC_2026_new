    tryCatch({
        fragSizeDist(bam, sample)
    }, error = function(e) {
        plot.new()
        text(0.5, 0.5, paste(sample, "\nERROR:", e$message))
    })
}

dev.off()

tss_pdf <- file.path(
    out_dir,
    "ATAC_TSS_enrichment_all_samples.pdf"
)

