###############################################################################
# STAGE 12 — Tn5 SHIFT
###############################################################################

stage_12() {
    log "STAGE 12: Tn5 shift correction"

    require_cmd alignmentSieve
    require_cmd samtools

    export TMPDIR="${TMP_DEEPTOOLS}"

    shopt -s nullglob
    local bams=("${BL_DIR}"/*_rmblacklisted.bam)
    (( ${#bams[@]} > 0 )) || die "No blacklist-filtered BAMs found for Stage 12"

    for BAM in "${bams[@]}"; do
        local sample
        sample=$(basename "${BAM%_rmblacklisted.bam}")

        local UNSORTED="${SHIFT_DIR}/${sample}_shifted_unsorted.bam"
        local SORTED="${SHIFT_DIR}/${sample}_shifted_sorted.bam"
        local METRICS="${SHIFT_DIR}/${sample}_shifted_metrics.txt"

        if [[ -s "${SORTED}" && -s "${SORTED}.bai" ]]; then
            log "SKIP Tn5 shifting: ${sample}"
            continue
        fi

        log "Tn5 shifting ${sample}"

        rm -f "${UNSORTED}"

        alignmentSieve \
            --ATACshift \
            -b "${BAM}" \
            -o "${UNSORTED}" \
            --filterMetrics "${METRICS}"

        samtools sort \
            --threads "${SAMTOOLS_SORT_THREADS}" \
            -m "${SORT_MEM}" \
            -o "${SORTED}" \
            "${UNSORTED}"

        samtools index -@ "${SAMTOOLS_VIEW_THREADS}" "${SORTED}"
        rm -f "${UNSORTED}"
    done

    shopt -s nullglob
    local count_bams=("${SHIFT_DIR}"/*_shifted_sorted.bam)
    for BAM_COUNT in "${count_bams[@]}"; do
        local sample_count
        sample_count=$(basename "${BAM_COUNT%_shifted_sorted.bam}")
        count_bam "12_Tn5_shifted_BAM" "${sample_count}" "${BAM_COUNT}"
    done

    show_read_count_summary
    log "STAGE 12 complete"
}

###############################################################################
# STAGE 13 — SHIFTED BAM -> BED
###############################################################################

stage_13() {
    log "STAGE 13: Shifted BAM -> BED"

    require_cmd bedtools

    shopt -s nullglob
    local bams=("${SHIFT_DIR}"/*_shifted_sorted.bam)
    (( ${#bams[@]} > 0 )) || die "No shifted BAMs found for Stage 13"

    for BAM in "${bams[@]}"; do
        local sample
        sample=$(basename "${BAM%_shifted_sorted.bam}")

        local OUT="${BED_DIR}/${sample}.bed"

        if [[ -s "${OUT}" ]]; then
            log "SKIP BAM -> BED: ${sample}"
            continue
        fi

        log "Converting ${sample} to BED"

        bedtools bamtobed -i "${BAM}" > "${OUT}"

        local n
        n=$(wc -l < "${OUT}")
        (( n > 0 )) || die "Empty BED produced for ${sample}"

        log "${sample}: ${n} BED alignments"
    done

    log "STAGE 13 complete"
}

###############################################################################
# STAGE 14 — MACS3 CUT-SITE PEAK CALLING
###############################################################################

stage_14() {
    log "STAGE 14: MACS3 cut-site peak calling"

    activate_macs3

    shopt -s nullglob
    local beds=("${BED_DIR}"/*.bed)
    (( ${#beds[@]} > 0 )) || die "No BED files found for Stage 14"

    for BED in "${beds[@]}"; do
        local sample
        sample=$(basename "${BED%.bed}")

        local NAME="${sample}.macs3"
        local PEAK_FILE="${MACS_DIR}/${NAME}_peaks.narrowPeak"

        if [[ -s "${PEAK_FILE}" ]]; then
            log "SKIP MACS3: ${sample}"
            continue
        fi

        log "Calling peaks for ${sample}"

        macs3 callpeak \
            -t "${BED}" \
            -f BED \
            -g hs \
            -n "${NAME}" \
            --outdir "${MACS_DIR}" \
            --nomodel \
            --shift -100 \
            --extsize 200 \
            --keep-dup all \
            --call-summits \
            -q 0.01 \
            -B \
            --SPMR
    done

    log "STAGE 14 complete"
}

###############################################################################
# STAGE 15 — PEAK COUNTS
###############################################################################

stage_15() {
    log "STAGE 15: Peak-count QC"

    local OUT="${PEAK_QC_DIR}/macs3_peak_counts.tsv"

    shopt -s nullglob
    local peaks=("${MACS_DIR}"/*.macs3_peaks.narrowPeak)
    (( ${#peaks[@]} > 0 )) || die "No MACS3 narrowPeak files found for Stage 15"

    {
        printf "Sample\tPeak_count\n"

        for PEAK in "${peaks[@]}"; do
            local sample
            sample=$(basename "${PEAK%.macs3_peaks.narrowPeak}")

            local count
            count=$(wc -l < "${PEAK}")

            printf "%s\t%s\n" "${sample}" "${count}"
        done
    } > "${OUT}"

    if have column; then
        column -t -s $'\t' "${OUT}"
    else
        cat "${OUT}"
    fi

    log "Saved ${OUT}"
    log "STAGE 15 complete"
}

###############################################################################
# STAGE 16 — bedGraph -> bigWig LOCALLY
###############################################################################

stage_16() {
    log "STAGE 16: bedGraph -> bigWig"

    require_cmd bedGraphToBigWig
    require_file "${CHROM_SIZES}"

    shopt -s nullglob
    local bdgs=("${MACS_DIR}"/*.macs3_treat_pileup.bdg)
    (( ${#bdgs[@]} > 0 )) || die "No MACS3 treatment pileup bedGraphs found"

    for BDG in "${bdgs[@]}"; do
        local sample
        sample=$(basename "${BDG%.macs3_treat_pileup.bdg}")

        local SORTED="${BW_DIR}/${sample}.sorted.bedGraph"
        local BW="${BW_DIR}/${sample}.bw"

        if [[ -s "${BW}" ]]; then
            log "SKIP bigWig: ${sample}"
            continue
        fi

        log "Creating bigWig for ${sample}"

        LC_ALL=C sort \
            -k1,1 \
            -k2,2n \
            "${BDG}" \
            > "${SORTED}"

        bedGraphToBigWig \
            "${SORTED}" \
            "${CHROM_SIZES}" \
            "${BW}"

        rm -f "${SORTED}"
    done

    log "STAGE 16 complete"
}

